# ==============================================================================
# Lido pelo Spring via `spring.config.import=optional:file:.env[.properties]`
# (ver application.yml). Formato Java .properties: NAO coloque aspas nos
# valores - elas viram parte do valor.
# ==============================================================================

# ==============================================================================
# App / Runtime
# ==============================================================================

# development | production | test - default: development.
# Em `production` o seed e recusado.
APP_ENV=development

# Perfil Spring ativo (dev | prod | test). `dev` liga logs legiveis e o
# endpoint /admin/queues; `prod` liga logs estruturados (ECS JSON) e o cookie
# Secure do refresh token.
SPRING_PROFILES_ACTIVE=dev

# Porta HTTP - default: 3000
PORT=3000

# ==============================================================================
# Database (PostgreSQL via JDBC + Flyway)
# ==============================================================================

DATABASE_URL=jdbc:postgresql://localhost:5432/auth_template
DATABASE_USERNAME=app
DATABASE_PASSWORD=senha123

# Tamanho do pool Hikari - default: 10. Ajuste em funcao de replicas x
# conexoes por replica x max_connections do Postgres.
# DATABASE_POOL_SIZE=10

# Flyway roda as migrations no boot por padrao (convencao Spring). Para
# aplicar manualmente (ex: pipeline separado) desligue aqui e rode
# `./mvnw flyway:migrate` ou o CLI do Flyway.
# FLYWAY_ENABLED=true

# ==============================================================================
# Redis (fila + cache) - duas instancias separadas de proposito
# ==============================================================================

# Filas (Redis Streams: e-mails, notificacoes) e pub/sub do WebSocket.
# Local via Docker: docker compose up -d redis-queue
REDIS_URL=redis://localhost:6379

# Cache de leitura, rate-limit e contador de lockout de login. Separado da
# fila para um pico de e-mails nao competir com um dado de seguranca.
# Local via Docker: docker compose up -d redis-cache
CACHE_REDIS_URL=redis://localhost:6380

# ==============================================================================
# Auth (JWT)
# ==============================================================================

# Segredo HS256 do access token. Minimo 32 caracteres - validado no boot e a
# aplicacao recusa subir enquanto estiver com o placeholder abaixo.
JWT_SECRET=troque-por-um-secret-forte-de-pelo-menos-32-caracteres

# ==============================================================================
# CORS (front-end)
# ==============================================================================

# Origens autorizadas, separadas por virgula. Obrigatoria quando o front esta
# em outra origem: com "*" o navegador rejeita credentials (cookie httpOnly
# do refresh token).
CORS_ORIGIN=http://localhost:5173

# Cookie do refresh token com flag Secure (so HTTPS). Ligue em producao
# (o perfil `prod` ja liga).
# COOKIE_SECURE=false

# ==============================================================================
# Reverse proxy / load balancer
# ==============================================================================

# `framework` faz o Spring honrar X-Forwarded-For/Proto (necessario atras de
# um LB/ingress, senao todo cliente cai no mesmo balde de rate limit).
# `none` (default) ignora esses headers - correto para acesso direto/local.
# NAO ligue sem um proxy de fato na frente: cliente falsificaria o IP.
# FORWARD_HEADERS_STRATEGY=framework

# ==============================================================================
# Armazenamento de arquivos
# ==============================================================================

# local (default) | s3
FILE_STORAGE=local
# Diretorio do adapter local - default: ./uploads
# UPLOAD_DIR=uploads
# Necessarios so com FILE_STORAGE=s3. Credenciais AWS pela cadeia padrao da
# SDK (env vars, IAM role...), nunca aqui.
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=meu-bucket

# ==============================================================================
# E-mail
# ==============================================================================

# log (default, so loga) | smtp (JavaMail; exige as SPRING_MAIL_* abaixo)
EMAIL_SENDER=log
EMAIL_FROM=no-reply@example.com
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ==============================================================================
# Senha vazada (HaveIBeenPwned, k-anonymity)
# ==============================================================================

# noop (default) | hibp
PASSWORD_BREACH_CHECKER=noop
