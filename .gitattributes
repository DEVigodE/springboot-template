# Normalize line endings in the repository; keep the Maven wrapper runnable on
# Linux (CI/Docker) regardless of the committer's OS.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw text eol=lf
*.sh text eol=lf

*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.pdf binary
